# FattoCRM — variáveis de ambiente do app ERP.
# Copia pra .env.local (gitignored) e preenche.

# === Supabase (FattoCRM — projeto próprio) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Branding ===
NEXT_PUBLIC_APP_NAME=FattoCRM

# === Provider IXC (opcional — só pra tenants que usam IXC) ===
# Hoje fica em .env pra teste rápido. Em produção vai pra provider_config (cifrado).
# IXC_BASE_URL=
# IXC_USER_ID=
# IXC_TOKEN_HASH=

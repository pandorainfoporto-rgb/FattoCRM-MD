{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_WHATSAPP_NUMBER",
        "NEXT_PUBLIC_PHONE_DISPLAY",
        "NEXT_PUBLIC_EMAIL",
        "NEXT_PUBLIC_OAB",
        "NEXT_PUBLIC_ADDRESS",
        "NEXT_PUBLIC_INSTAGRAM_URL"
      ]
    },
    "lint": {},
    "typecheck": {},
    "clean": {
      "cache": false
    }
  }
}
